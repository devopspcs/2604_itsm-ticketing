# Database
DATABASE_URL=postgres://itsm:itsm@localhost:5432/itsm?sslmode=disable

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Webhook
WEBHOOK_SECRET=your-webhook-hmac-secret-change-in-production

# Server
PORT=8080

# Migration
MIGRATION_PATH=file://migrations

# Email SMTP
APP_EMAIL_SMTP_HOST=mail.privateemail.com
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_USER=noreply@pcsindonesia.com
APP_EMAIL_SMTP_PASS=your-email-password
APP_EMAIL_SENDER_EMAIL=noreply@pcsindonesia.com

# Google Drive Storage (for ticket attachments)
# Option 1: Path to service account JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json
# Option 2: Inline JSON (for Docker/cloud deployments)
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account","project_id":"..."}
# The Google Drive folder ID where attachments will be stored
GOOGLE_DRIVE_FOLDER_ID=your-drive-folder-id

# Service Access Integration
# POSe API
POSE_API_URL=https://pose-api.pcsindonesia.co.id/master/user?filter=pcsindonesia.co.id&order=created_at:-1&page_size=-1&page=1
POSE_API_TOKEN=your-pose-api-token

# Pritunl VPN
PRITUNL_URL=https://35.219.125.94
PRITUNL_USERNAME=your-pritunl-username
PRITUNL_PASSWORD=your-pritunl-password
PRITUNL_ORG_ID=your-pritunl-org-id

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
